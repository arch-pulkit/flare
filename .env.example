# FLARE environment variables
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# run_pipeline.py checks these at startup via check_env_vars() and exits with a
# clear message if any are missing. ASTR-O raises ValueError immediately rather
# than falling back silently, so an unset secret fails fast rather than
# producing unsigned reports.

# HMAC-SHA256 secret used by registry_builder.py to sign the reference registry.
# Use a long random value, e.g. `openssl rand -hex 32`. Changing it invalidates
# signatures on an already-built reference_registry.json.
ASTR_O_REGISTRY_SECRET=

# HMAC-SHA256 secret used by integrity_signer.py to sign audit reports.
# Independent of the registry secret — do not reuse the same value.
ASTR_O_REPORT_SECRET=

# Only required when running with --backend openai (the default).
# Not needed for --backend llama_cpp.
OPENAI_API_KEY=
